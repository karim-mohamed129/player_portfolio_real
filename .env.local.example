# =========================
# Player Portfolio Dashboard
# انسخ الملف ده باسم .env.local محلياً
# وعلى Vercel ضيف نفس القيم من Project Settings > Environment Variables
# =========================

# MongoDB Atlas
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/player_portfolio?retryWrites=true&w=majority&appName=Cluster0"

# Auth Secret - لازم يكون طويل وعشوائي
AUTH_SECRET="change_this_to_a_very_long_random_secret_at_least_32_chars"

# First Admin Account
# أول مرة تعمل Login، النظام هيعمل Admin في MongoDB تلقائياً بالقيم دي لو مفيش Admin موجود.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!StrongPassword"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="player-portfolio"

# Public URL
NEXT_PUBLIC_SITE_URL="http://localhost:9682"


# Contact Form Email Receiving
# الرسائل هتتحفظ في MongoDB، ولو بيانات SMTP دي مكتملة هتتبعت نسخة على الإيميل.
CONTACT_RECEIVER_EMAIL="your-receiving-email@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-smtp-email@example.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM_NAME="Player Portfolio Website"
SMTP_FROM_EMAIL="your-smtp-email@example.com"
